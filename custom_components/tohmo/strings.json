{
  "config": {
    "step": {
      "user": {
        "title": "Tohmo account",
        "description": "Sign in with the credentials of your Tohmo customer area (app.go-tohmo.com).",
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "Tohmo rejected the password of {email}. Enter the current password.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "wrong_account": "This password belongs to another Tohmo account."
    }
  },
  "device": {
    "account": {
      "name": "Tohmo account"
    }
  },
  "entity": {
    "binary_sensor": {
      "charging": {
        "name": "Charging"
      },
      "off_peak": {
        "name": "Off-peak hours"
      }
    },
    "sensor": {
      "energy_total": {
        "name": "Total energy"
      },
      "cost_total": {
        "name": "Total cost"
      },
      "last_session_energy": {
        "name": "Last session energy"
      },
      "last_session_cost": {
        "name": "Last session cost"
      },
      "last_session_start": {
        "name": "Last session start"
      },
      "last_session_end": {
        "name": "Last session end"
      },
      "last_session_duration": {
        "name": "Last session duration"
      },
      "charging_mode": {
        "name": "Charging mode",
        "state": {
          "eco": "Eco",
          "continuous": "Continuous"
        }
      },
      "last_heartbeat": {
        "name": "Last heartbeat"
      },
      "period_energy": {
        "name": "Billing period energy"
      },
      "period_cost": {
        "name": "Billing period cost"
      },
      "period_sessions": {
        "name": "Billing period sessions"
      },
      "next_off_peak": {
        "name": "Next off-peak"
      },
      "off_peak_start": {
        "name": "Off-peak {index} start"
      },
      "off_peak_end": {
        "name": "Off-peak {index} end"
      },
      "subscription_fee": {
        "name": "Monthly subscription"
      },
      "price_peak": {
        "name": "Peak price"
      },
      "price_off_peak": {
        "name": "Off-peak price"
      },
      "last_invoice": {
        "name": "Last invoice"
      },
      "pending_invoices": {
        "name": "Pending invoices"
      }
    }
  }
}
